# Copy to /etc/llm-manager-agent.env, then: sudo chmod 600 /etc/llm-manager-agent.env
# Values come from the server's page in the LLM-Manager dashboard (Monitoring agent section).
LLM_MANAGER_API_URL=https://your-production-domain.vercel.app/api/telemetry
LLM_MANAGER_SERVER_ID=00000000-0000-0000-0000-000000000000
LLM_MANAGER_TOKEN=lmt_paste_token_here
# Optional:
# LLM_MANAGER_INTERVAL=30
# LLM_MANAGER_DISK_PATH=/
